# Copy to `.env` and fill in from your Supabase project (Settings → API).
# Expo inlines EXPO_PUBLIC_* vars at build time. The anon key is safe to ship —
# RLS (packages/api/src/schema.sql) serves only published content to anon.
# Without these set, the app runs on bundled sample data.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
