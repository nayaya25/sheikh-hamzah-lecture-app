{
  "expo": {
    "name": "Althaqalayn Lectures",
    "slug": "althaqalayn-lectures",
    "version": "1.0.0",
    "scheme": "althaqalayn",
    "orientation": "portrait",
    "icon": "./assets/logo/althaqalayn_icon_green.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.althaqalayn.lectures",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.althaqalayn.lectures",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B4634",
        "foregroundImage": "./assets/logo/althaqalayn_icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      ["expo-audio", { "enableBackgroundPlayback": true }]
    ]
  }
}
