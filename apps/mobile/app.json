{
  "expo": {
    "name": "Althaqalayn Lectures",
    "slug": "althaqalayn-lectures",
    "version": "1.0.0",
    "scheme": "althaqalayn",
    "orientation": "portrait",
    "icon": "./assets/logo/althaqalayn_icon_green.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.althaqalayn.lectures"
    },
    "android": {
      "package": "com.althaqalayn.lectures",
      "adaptiveIcon": {
        "backgroundColor": "#0B4634",
        "foregroundImage": "./assets/logo/althaqalayn_icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B4634",
          "image": "./assets/logo/althaqalayn_icon_green.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "expo-image"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "15632268-04cc-4a39-a69d-33f14f222d84"
      }
    },
    "owner": "nayaya25"
  }
}
